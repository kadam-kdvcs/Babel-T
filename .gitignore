# Python 缓存
__pycache__/
*.py[cod]

# 虚拟环境
.venv/
venv/

# 测试缓存
.pytest_cache/
# 本地测试临时目录（沙箱/Windows 偶发无法自动清理）
pytest_tmp*/
pt_*/
tmp[0-9]+/

# Streamlit（为未来 secrets.toml 预留；本阶段无密钥）
.streamlit/

# 环境变量（API Key 绝不入库，阶段 2 起使用）
.env

# 日志
*.log

# SQLite 数据库（阶段 4 运行数据，不入库）
data/*.db
data/*.db-wal
data/*.db-shm

# IDE 配置
.idea/
.vscode/
