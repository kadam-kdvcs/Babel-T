# ============================================================
# 环境变量模板（.env.example）
# 用途：列出本项目的全部环境变量及用途说明，供开发者对照填写。
# 使用方法：把本文件复制为 .env（放在项目根目录），再在 .env 中
# 填入自己的真实密钥。.env 已被 .gitignore 忽略，绝不会提交 git；
# 本模板文件 .env.example 里永远只放占位说明，绝不写真实密钥。
# ============================================================

# 翻译引擎模式：mock（占位译文，不联网，默认）/ api（调用阿里云机器翻译）。
# 取其他值会在启动时抛出配置错误。
TRANSLATION_ENGINE=

# 阿里云 AccessKey ID（API 模式必填；缺 key 时自动回退占位译文）。
# 获取方式：阿里云控制台 → RAM 访问控制 → 创建 AccessKey。
# 安全提醒：仅填在本地的 .env，绝不提交 git、绝不写进代码或日志。
ALIYUN_ACCESS_KEY_ID=

# 阿里云 AccessKey Secret（同上，API 模式必填）。
ALIYUN_ACCESS_KEY_SECRET=

# 阿里云机器翻译服务地址（一般无需修改；如需代理等特殊场景可覆盖）。
ALIYUN_MT_ENDPOINT=

# 源语言代码（阿语为 ar，默认即可）。
TRANSLATION_SOURCE_LANG=

# 目标语言代码（中文为 zh，默认即可）。
TRANSLATION_TARGET_LANG=

# 翻译场景（机器翻译的领域设置，默认 general 即可）。
TRANSLATION_SCENE=

# 单次翻译请求的超时秒数（正整数，默认 30）。
TRANSLATION_TIMEOUT_SECONDS=

# 审校引擎模式：mock（占位报告，不联网，默认）/ api（调用 LLM 生成审校报告）。
# 取其他值会在启动时抛出配置错误。
REVIEW_ENGINE=

# DeepSeek API Key（LLM 审校凭证；api 模式必填；缺 key 时自动回退占位报告）。
# 获取方式：DeepSeek 开放平台 → API Keys → 创建。
# 安全提醒：仅填在本地的 .env，绝不提交 git、绝不写进代码、测试或日志。
DEEPSEEK_API_KEY=

# DeepSeek 接口地址（base URL，不含 /chat/completions 路径，程序自动拼接；
# 默认 https://api.deepseek.com；兼容 OpenAI 格式的其他服务可覆盖此值）。
DEEPSEEK_API_URL=

# LLM 审校模型名（默认 deepseek-chat 即可）。
REVIEW_MODEL=

# 单次审校请求的超时秒数（正整数，默认 30）。
REVIEW_TIMEOUT_SECONDS=

# SQLite 数据库路径（阶段 4）。默认放在项目 data/translations.db；
# 如需指定其他位置（例如备份目录），设置 DATABASE_PATH=/绝对路径/xxx.db
DATABASE_PATH=
